# Smart Parking Management System - Environment Variables
# Copy this file to .env and fill in your actual MySQL password.
# NEVER commit .env to version control.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ParkingLot
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Storage used by the Streamlit app:
#   mysql - MySQL stored procedures (above) + C++ fare engine   (default)
#   csv   - no database needed: the C++ core keeps parking_data.csv
PARKING_BACKEND=mysql

# Optional overrides (paths relative to the project folder by default)
# YOLO_MODEL_PATH=best.pt
# PARKING_CSV_PATH=parking_data.csv
# PARKING_CONFIG_PATH=config/parking.cfg
# PARKING_CORE_EXE=build/parkinglot.exe
