{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ core (build.bat)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Run C++ unit tests",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat test",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": "test"
        },
        {
            "label": "Run OOP demo",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\parkinglot.exe demo",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Build C++ core (CMake)",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
